{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "shared",
    "api",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,client -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=client --port=3001\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=api",
    "migrate:logs": "npm run migrate:logs --workspace=api",
    "migrate:guides": "npm run migrate:guides --workspace=api --",
    "pr": "node tools/pr-builder/src/cli.js",
    "pr:test": "node --test tools/pr-builder/test",
    "typecheck": "npm run codegen --workspace=client && npm run typecheck --workspace=client && npm run typecheck --workspace=api",
    "lint": "npm run lint --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "test:api": "npm run test --workspace=api",
    "build": "npm run build --workspace=client",
    "codegen": "npm run codegen --workspace=client"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
