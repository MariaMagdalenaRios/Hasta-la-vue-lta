DATABASE_URL=postgresql://utpost:utpost@localhost:5433/utpost
MONGO_URL=mongodb://utpost:utpost@localhost:27017/utpost?authSource=admin
# Generate your own: openssl rand -hex 32
JWT_SECRET=replace-with-a-generated-secret
PORT=4000
GIT_SHA=dev
IMAGE_FUNCTION_URL=http://localhost:7071/api/process-image
IMAGE_FUNCTION_KEY=

# CMS (M9) - editorial content lives in Contentful (api/src/cms/contentful.js).
# Without a space ID and delivery token the CMS is switched off: the app runs, with no notices.
# The space ID is not a secret, the tokens are.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
# SECRET. Content Delivery API token: reads published content only
CONTENTFUL_DELIVERY_TOKEN=
# SECRET. Content Preview API token: also reads drafts, only for editor preview
CONTENTFUL_PREVIEW_TOKEN=
# How long published notices are served from memory before Contentful is asked again
CMS_CACHE_SECONDS=60
# SECRET. Content Management API token (CMA): can write. Only for the guide migration script, never for the running app.
# Optional: leave it empty and run `npx contentful-cli login` instead.
CONTENTFUL_MANAGEMENT_TOKEN=
CMS_WEBHOOK_SECRET=                                                # HEMLIGHET. Det Contentful skickar i headern X-Utpost-Webhook-Secret när något publiceras. Generera: openssl rand -hex 24. Tom = webhooken är stängd
